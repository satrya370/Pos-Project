# ===========================================
# PosLite Environment Variables
# ===========================================

# Database
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@host:5432/poslite"

# Server
NODE_ENV="development"
PORT=3000
CLIENT_URL="http://localhost:5173"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ===========================================
# AI PROVIDER - GROQ (FREE - Primary Output)
# ===========================================
GROQ_API_KEY="gsk_xxxxx"
GROQ_MODEL_LARGE="llama-3.3-70b-versatile"
GROQ_MODEL_SMALL="llama-3.1-8b-instant"
GROQ_TIMEOUT=45000

# ===========================================
# AI PROVIDER - KOBOILLM (PAID - Analysis)
# ===========================================
KOBO_API_KEY="your-kobo-api-key"
KOBO_BASE_URL="https://kobo.sharkcore.xyz/v1"
KOBO_MODEL="gpt-oss-120b"
KOBO_TIMEOUT=90000

# ===========================================
# AI PROVIDER - OPENROUTER (Fallback)
# ===========================================
OPENROUTER_API_KEY="sk-or-v1-xxxxx"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_TIMEOUT=45000

# ===========================================
# AI SETTINGS
# ===========================================
AI_TEMPERATURE_ANALYSIS=0.5
AI_TEMPERATURE_OUTPUT=0.4
AI_TEMPERATURE_NOTIFICATION=0.3

AI_MAX_TOKENS_ANALYSIS=2000
AI_MAX_TOKENS_OUTPUT=1000
AI_MAX_TOKENS_NOTIFICATION=500

AI_FALLBACK_ENABLED=true
AI_CACHE_ENABLED=true

# ===========================================
# CACHE SETTINGS
# ===========================================
CACHE_TTL_DAILY=82800
CACHE_TTL_WEEKLY=518400
CACHE_TTL_RECOMMENDATION=604800

# ===========================================
# WHATSAPP (Bailey API)
# ===========================================
BAILE_WA_API_KEY="your-bailey-api-key"
BAILE_WA_URL="https://wa.baileenterprise.com/api"
BAILE_WA_ENABLED="true"

# ===========================================
# TELEGRAM BOT
# ===========================================
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_OWNER_CHAT_ID="your-chat-id"
TELEGRAM_ENABLED="true"

# ===========================================
# CRON SCHEDULE (UTC)
# ===========================================
CRON_DAILY_SUMMARY="0 14 * * *"
CRON_WEEKLY_REPORT="0 14 * * 0"
CRON_LOW_STOCK_CHECK="0 */4 * * *"