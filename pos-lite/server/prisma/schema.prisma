// Prisma schema for PosLite
// Database: SQLite (dev) / PostgreSQL (prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Owner {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String
  phone          String?
  waNumber       String?
  telegramChatId String?
  dailyTarget    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products      Product[]
  categories    Category[]
  transactions  Transaction[]
  suppliers     Supplier[]
  customers     Customer[]
  insights      AIInsightCache[]
}

model Category {
  id        String    @id @default(uuid())
  ownerId   String
  name      String
  icon      String?
  createdAt DateTime  @default(now())

  owner    Owner     @relation(fields: [ownerId], references: [id])
  products Product[]

  @@unique([ownerId, name])
}

model Supplier {
  id        String    @id @default(uuid())
  ownerId   String
  name      String
  contact  String?
  phone     String?
  address   String?
  createdAt DateTime  @default(now())

  owner    Owner     @relation(fields: [ownerId], references: [id])
  products Product[]

  @@unique([ownerId, name])
}

model Product {
  id                 String    @id @default(uuid())
  ownerId            String
  categoryId         String?
  supplierId         String?
  sku                String?
  name               String
  description        String?
  purchasePrice      Float     @default(0)
  sellingPrice       Float
  imageUrl           String?
  minStockThreshold  Int       @default(5)
  isBundle           Boolean   @default(false)
  bundleProducts     String?
  weight             Float?
  weightUnit         String?
  expiryDate         DateTime?
  variantLabel       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner             Owner             @relation(fields: [ownerId], references: [id])
  category          Category?         @relation(fields: [categoryId], references: [id])
  supplier          Supplier?         @relation(fields: [supplierId], references: [id])
  sizes             ProductSize[]
  transactionItems  TransactionItem[]
  stockMovements    StockMovement[]
}

model ProductSize {
  id          String  @id @default(uuid())
  productId   String
  name        String
  variantName String  @default("")
  stock       Int     @default(0)
  sku         String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name, variantName])
}

model Transaction {
  id            String      @id @default(uuid())
  ownerId       String
  invoiceNumber String      @unique
  totalAmount   Float
  totalCost     Float
  profit        Float
  itemsCount    Int
  notes         String?
  status        String      @default("completed")
  paymentStatus String      @default("paid")
  customerId    String?
  customerName  String?
  createdAt     DateTime    @default(now())

  owner        Owner             @relation(fields: [ownerId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  items        TransactionItem[]
  debtPayments DebtPayment[]
}

model TransactionItem {
  id              String      @id @default(uuid())
  transactionId   String
  productId       String?
  productSizeId   String?
  productName     String
  size            String?
  quantity        Int
  unitPrice       Float
  costAtPurchase  Float
  discountPercent Float       @default(0)
  discountAmount  Float       @default(0)
  subtotal        Float

  transaction Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id])
}

model StockMovement {
  id            String    @id @default(uuid())
  productId     String
  type          String
  quantity      Int
  referenceId   String?
  notes         String?
  purchasePrice Float?
  invoiceNumber String?
  supplierId    String?
  createdAt     DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model Customer {
  id        String    @id @default(uuid())
  ownerId   String
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner        Owner         @relation(fields: [ownerId], references: [id])
  transactions Transaction[]

  @@unique([ownerId, phone])
  @@index([ownerId])
}

model DebtPayment {
  id            String    @id @default(uuid())
  transactionId String
  amount        Float
  notes         String?
  paidAt        DateTime  @default(now())
  createdAt     DateTime  @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
}

model AIInsightCache {
  id          String    @id @default(uuid())
  ownerId     String
  type        String
  period      String
  content     String
  metadata    String?
  generatedAt DateTime  @default(now())
  expiresAt   DateTime

  owner Owner @relation(fields: [ownerId], references: [id])

  @@index([ownerId, type, period])
}
